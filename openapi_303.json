              "device_id": "WEB-PORTAL",
              "disclaimer": "Las alertas son indicativas. No constituyen evidencia de fraude ni implican culpabilidad.",
              "recommendation": "Sin señales de alerta detectadas.",
              "rules_version": "v1.0",
